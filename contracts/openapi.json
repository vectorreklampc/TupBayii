            }
          },
          "400": { "$ref": "#/components/responses/Hata" },
          "401": { "$ref": "#/components/responses/Hata" },
          "403": { "$ref": "#/components/responses/Hata" },
          "500": { "$ref": "#/components/responses/Hata" }
        }
      }
    }
  },
  "tags": [
    { "name": "System", "description": "Platform durum operasyonlari." }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Tenant, kullanici ve rol sunucuda token kimliginden cozulur; client tenant beyani authoritative degildir. Gecersiz veya baska tenant kapsamli token fail closed reddedilir."
      }
    },
    "schemas": {
      "SistemSaglik": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "apiVersion", "timestampUtc", "traceId"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "service": { "type": "string", "minLength": 1 },
          "apiVersion": { "type": "string", "pattern": "^v[0-9]+$" },
          "timestampUtc": { "type": "string", "format": "date-time" },
          "traceId": { "type": "string", "minLength": 1 }
        }
      },
      "Hata": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "traceId"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$" },
          "message": { "type": "string" },
          "traceId": { "type": "string" },
          "details": { "type": "array", "items": { "$ref": "#/components/schemas/DogrulamaDetayi" } }
        }
      },
      "DogrulamaDetayi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "code"],
        "properties": {
          "field": { "type": "string" },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$" }
        }
      },
      "Sayfalama": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "pageSize", "totalItems", "totalPages"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1 },
          "totalItems": { "type": "integer", "minimum": 0 },
          "totalPages": { "type": "integer", "minimum": 0 }
        }
      },
      "ParaTutari": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tutar", "paraBirimi"],
        "properties": {
          "tutar": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$", "description": "Iki ondalikli decimal metin." },
          "paraBirimi": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 kodu." }
        }
      },
      "OturumAcmaIstegi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kullaniciAdi", "parola"],
        "properties": {
          "kullaniciAdi": { "type": "string", "minLength": 1 },
          "parola": { "type": "string", "minLength": 1, "format": "password", "writeOnly": true }
        }
      },
      "OturumYaniti": {
        "type": "object",
        "required": ["oturumId", "accessToken", "tokenType", "sonaErmeZamaniUtc"],
        "properties": {
          "oturumId": { "type": "string", "format": "uuid" },
          "accessToken": { "type": "string" },
          "tokenType": { "type": "string", "enum": ["Bearer"] },
          "sonaErmeZamaniUtc": { "type": "string", "format": "date-time" }
        }
      },
      "OturumSonlandirmaSonucu": {
        "type": "object",
        "required": ["oturumId", "sonlandirmaZamaniUtc"],
        "properties": {
          "oturumId": { "type": "string", "format": "uuid" },
          "sonlandirmaZamaniUtc": { "type": "string", "format": "date-time" }
        }
      },
      "MusteriOlusturmaIstegi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ad", "telefon"],
        "properties": {
          "ad": { "type": "string", "minLength": 1 },
          "telefon": { "type": "string", "minLength": 1 }
        }
      },
      "MusteriGuncellemeIstegi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version"],
        "minProperties": 2,
        "properties": {
          "version": { "type": "integer", "minimum": 1, "description": "Beklenen version; stale ise 409 CONCURRENCY_CONFLICT." },
          "ad": { "type": "string", "minLength": 1 },
          "telefon": { "type": "string", "minLength": 1 }
        }
      },
      "MusteriPasiflestirmeIstegi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version"],
        "properties": {
          "version": { "type": "integer", "minimum": 1, "description": "Beklenen version; stale ise 409 CONCURRENCY_CONFLICT." }
        }
      },
      "Musteri": {
        "type": "object",
        "required": ["musteriId", "ad", "telefon", "aktifMi", "version"],
        "properties": {
          "musteriId": { "type": "string", "format": "uuid" },
          "ad": { "type": "string" },
          "telefon": { "type": "string" },
          "aktifMi": { "type": "boolean" },
          "version": { "type": "integer", "minimum": 1 }
        }
      },
      "Urun": {
        "type": "object",
        "required": ["urunId", "ad"],
        "properties": {
          "urunId": { "type": "string", "format": "uuid" },
          "ad": { "type": "string" }
        }
      },
      "UrunFiyati": {
        "type": "object",
        "required": ["urunId", "birimFiyat"],
        "properties": {
          "urunId": { "type": "string", "format": "uuid" },
          "birimFiyat": { "$ref": "#/components/schemas/ParaTutari" }
        }
      },
      "TupDurumu": {
        "type": "string",
        "enum": ["FULL", "EMPTY"]
      },
      "StokKalemi": {
        "type": "object",
        "required": ["urunId", "tupDurumu", "miktar"],
        "properties": {
          "urunId": { "type": "string", "format": "uuid" },
          "tupDurumu": { "$ref": "#/components/schemas/TupDurumu" },
          "miktar": { "type": "integer", "minimum": 0 }
        }
      },
      "StokHareketi": {
        "type": "object",
        "description": "Append-only stok hareketi; kaynakId ayni mantiksal hareketin tekrar yazilmasini engelleyen is referansidir.",
        "required": ["stokHareketiId", "urunId", "tupDurumu", "miktarDegisimi", "hareketTuru", "kaynakId", "olusmaZamaniUtc"],
        "properties": {
          "stokHareketiId": { "type": "string", "format": "uuid" },
          "urunId": { "type": "string", "format": "uuid" },
          "tupDurumu": { "$ref": "#/components/schemas/TupDurumu" },
          "miktarDegisimi": { "type": "integer" },
          "hareketTuru": { "type": "string", "enum": ["SATIS", "SATIS_IPTALI", "BOS_IADE", "DUZELTME"] },
          "kaynakId": { "type": "string", "format": "uuid" },
          "olusmaZamaniUtc": { "type": "string", "format": "date-time" }
        }
      },
      "StokDuzeltmeIstegi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["urunId", "tupDurumu", "miktarDegisimi"],
        "properties": {
          "urunId": { "type": "string", "format": "uuid" },
          "tupDurumu": { "$ref": "#/components/schemas/TupDurumu" },
          "miktarDegisimi": { "type": "integer", "not": { "const": 0 } },
          "aciklama": { "type": "string", "minLength": 1 }
        }
      },
      "SatisKalemi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["urunId", "miktar"],
        "properties": {
          "urunId": { "type": "string", "format": "uuid" },
          "miktar": { "type": "integer", "minimum": 1, "description": "Satilan FULL adet." },
          "bosIadeMiktari": { "type": "integer", "minimum": 0, "description": "Iade alinan EMPTY adet." }
        }
      },
      "NakitOdeme": {
        "type": "object",
        "additionalProperties": false,
        "required": ["odemeTuru"],
        "properties": {
          "odemeTuru": { "type": "string", "enum": ["NAKIT"] }
        }
      },
      "CariOdeme": {
        "type": "object",
        "additionalProperties": false,
        "required": ["odemeTuru", "musteriId"],
        "properties": {
          "odemeTuru": { "type": "string", "enum": ["CARI"] },
          "musteriId": { "type": "string", "format": "uuid" }
        }
      },
      "SatisTamamlamaIstegi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kalemler", "odeme"],
        "properties": {
          "kalemler": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/SatisKalemi" } },
          "odeme": {
            "oneOf": [
              { "$ref": "#/components/schemas/NakitOdeme" },
              { "$ref": "#/components/schemas/CariOdeme" }
            ],
            "discriminator": {
              "propertyName": "odemeTuru",
              "mapping": {
                "NAKIT": "#/components/schemas/NakitOdeme",
                "CARI": "#/components/schemas/CariOdeme"
              }
            }
          }
        }
      },
      "SatisKalemiSonucu": {
        "type": "object",
        "required": ["urunId", "miktar", "bosIadeMiktari", "birimFiyat", "tutar"],
        "properties": {
          "urunId": { "type": "string", "format": "uuid" },
          "miktar": { "type": "integer", "minimum": 1 },
          "bosIadeMiktari": { "type": "integer", "minimum": 0 },
          "birimFiyat": { "$ref": "#/components/schemas/ParaTutari" },
          "tutar": { "$ref": "#/components/schemas/ParaTutari" }
        }
      },
      "Satis": {
        "type": "object",
        "required": ["satisId", "durum", "odemeTuru", "kalemler", "toplamTutar", "stokHareketleri", "olusmaZamaniUtc"],
        "properties": {
          "satisId": { "type": "string", "format": "uuid" },
          "durum": { "type": "string", "enum": ["TAMAMLANDI", "IPTAL_EDILDI"] },
          "odemeTuru": { "type": "string", "enum": ["NAKIT", "CARI"] },
          "musteriId": { "type": "string", "format": "uuid" },
          "kalemler": { "type": "array", "items": { "$ref": "#/components/schemas/SatisKalemiSonucu" } },
          "toplamTutar": { "$ref": "#/components/schemas/ParaTutari" },
          "stokHareketleri": { "type": "array", "items": { "$ref": "#/components/schemas/StokHareketi" } },
          "olusmaZamaniUtc": { "type": "string", "format": "date-time" }
        }
      },
      "SatisIptalIstegi": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "aciklama": { "type": "string", "minLength": 1 }
        }
      },
      "KasaAcilisIstegi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acilisTutari"],
        "properties": {
          "acilisTutari": { "$ref": "#/components/schemas/ParaTutari" }
        }
      },
      "KasaAcilisi": {
        "type": "object",
        "required": ["tarih", "acilisTutari", "acilisZamaniUtc"],
        "properties": {
          "tarih": { "type": "string", "format": "date" },
          "acilisTutari": { "$ref": "#/components/schemas/ParaTutari" },
          "acilisZamaniUtc": { "type": "string", "format": "date-time" }
        }
      },
      "GunSonuSayimiIstegi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sayilanNakitTutari"],
        "properties": {
          "sayilanNakitTutari": { "$ref": "#/components/schemas/ParaTutari" }
        }
      },
      "GunSonuSayimi": {
        "type": "object",
        "required": ["tarih", "sayilanNakitTutari", "kayitZamaniUtc"],
        "properties": {
          "tarih": { "type": "string", "format": "date" },
          "sayilanNakitTutari": { "$ref": "#/components/schemas/ParaTutari" },
          "kayitZamaniUtc": { "type": "string", "format": "date-time" }
        }
      },
      "GunlukKasaOzeti": {
        "type": "object",
        "description": "Kasa gununun sunucu projection'indan okunan authoritative ozeti; tum tutarlar sunucuda hesaplanir, client hesaplamaz ve yalniz gosterir. Senaryo: kasa acilisi acilisTutari'ni, gun icindeki satislar nakitToplami/cariToplami'ni belirler; gun sonu sayimi kaydedilene kadar sayilanNakitTutari ve sayimFarki null doner, sayimdan sonra dolu doner.",
        "required": ["tarih", "nakitToplami", "cariToplami", "satisToplami", "acilisTutari", "beklenenKasaTutari", "sayilanNakitTutari", "sayimFarki"],
        "properties": {
          "tarih": { "type": "string", "format": "date" },
          "nakitToplami": { "$ref": "#/components/schemas/ParaTutari", "description": "Gunun nakit satislarinin NET toplami; iptal edilen satisin atomik ters kaydi dusulur." },
          "cariToplami": { "$ref": "#/components/schemas/ParaTutari", "description": "Gunun cari satislarinin NET toplami; iptal edilen satisin atomik ters kaydi dusulur." },
          "satisToplami": { "$ref": "#/components/schemas/ParaTutari", "description": "Gunluk satis toplami; nakitToplami + cariToplami." },
          "acilisTutari": { "$ref": "#/components/schemas/ParaTutari", "description": "Kasa acilisinda kaydedilen tutar." },
          "beklenenKasaTutari": { "$ref": "#/components/schemas/ParaTutari", "description": "Kasada olmasi gereken nakit; acilisTutari + nakitToplami. Cari satis kasaya nakit girisi yapmaz." },
          "sayilanNakitTutari": {
            "oneOf": [{ "$ref": "#/components/schemas/ParaTutari" }, { "type": "null" }],
            "description": "Gun sonu sayiminda kaydedilen nakit; sayim kaydedilmeden once null."
          },
          "sayimFarki": {
            "oneOf": [{ "$ref": "#/components/schemas/ParaTutari" }, { "type": "null" }],
            "description": "sayilanNakitTutari - beklenenKasaTutari; negatif kasa eksigi, pozitif kasa fazlasidir. Sayim kaydedilmeden once null."
          }
        }
      }
    },
    "headers": {
      "TraceId": {
        "description": "Istek ile iliskili guvenli iz kimligi; hata govdesindeki traceId ile aynidir.",
        "schema": { "type": "string" },
        "example": "trace-example-001"
      }
    },
    "responses": {
      "Hata": {
        "description": "Kararli hata kodu ve guvenli aciklama.",
        "headers": { "TraceId": { "$ref": "#/components/headers/TraceId" } },
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } }
        }
      }
    },
    "parameters": {
      "Page": {
        "name": "page", "in": "query", "description": "Bir tabanli sayfa numarasi.",
        "schema": { "type": "integer", "minimum": 1 }
      },
      "PageSize": {
        "name": "pageSize", "in": "query", "description": "Sunucunun sinirladigi sayfa boyutu.",
        "schema": { "type": "integer", "minimum": 1 }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key", "in": "header", "required": true,
        "description": "Ayni logical islem retry'larinda ayni kalan client anahtari; kapsam sunucuda (tenant, operasyon, anahtar) olarak cozulur. Ayni anahtar ve ayni payload kayitli sonucu ikinci etki olmadan doner. Ayni anahtar farkli payload ile 409 IDEMPOTENCY_CONFLICT doner. Ilk istek islenirken gelen kopya ikinci yurutme baslatmaz, 409 IDEMPOTENCY_IN_PROGRESS doner; client ayni anahtar ve payload ile daha sonra tekrar dener.",
        "schema": { "type": "string", "minLength": 1 }
      }
    }
  }
}
