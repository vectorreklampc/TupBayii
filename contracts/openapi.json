{
  "openapi": "3.1.0",
  "info": {
    "title": "TupBayiProje HTTP API",
    "version": "0.1.0",
    "description": "TBP-21 contract temeli. Onayli endpoint'ler kendi Jira islerinde eklenir."
  },
  "tags": [
    { "name": "System", "description": "Platform durum operasyonlari." }
  ],
  "paths": {
    "/api/v1/system/health": {
      "get": {
        "tags": ["System"],
        "operationId": "getSystemHealth",
        "summary": "API platform durumunu getirir",
        "security": [],
        "x-anonymous-reason": "Yuk dengeleyici ve istemci baslangic kontrolleri kimliksiz durum bilgisine gereksinim duyar.",
        "x-collection": false,
        "responses": {
          "200": {
            "description": "API platformu istek kabul edebilir.",
            "headers": {
              "TraceId": { "$ref": "#/components/headers/TraceId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SistemSaglik" },
                "example": {
                  "status": "ok",
                  "service": "tup-bayi-api",
                  "apiVersion": "v1",
                  "timestampUtc": "2026-10-07T00:00:00Z",
                  "traceId": "trace-example-001"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Hata" },
          "401": { "$ref": "#/components/responses/Hata" },
          "403": { "$ref": "#/components/responses/Hata" },
          "500": { "$ref": "#/components/responses/Hata" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SistemSaglik": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "apiVersion", "timestampUtc", "traceId"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "service": { "type": "string", "minLength": 1 },
          "apiVersion": { "type": "string", "pattern": "^v[0-9]+$" },
          "timestampUtc": { "type": "string", "format": "date-time" },
          "traceId": { "type": "string", "minLength": 1 }
        }
      },
      "Hata": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "traceId"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$" },
          "message": { "type": "string" },
          "traceId": { "type": "string" },
          "details": { "type": "array", "items": { "$ref": "#/components/schemas/DogrulamaDetayi" } }
        }
      },
      "DogrulamaDetayi": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "code"],
        "properties": {
          "field": { "type": "string" },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$" }
        }
      },
      "Sayfalama": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "pageSize", "totalItems", "totalPages"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1 },
          "totalItems": { "type": "integer", "minimum": 0 },
          "totalPages": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "headers": {
      "TraceId": {
        "description": "Istek ile iliskili guvenli iz kimligi; hata govdesindeki traceId ile aynidir.",
        "schema": { "type": "string" },
        "example": "trace-example-001"
      }
    },
    "responses": {
      "Hata": {
        "description": "Kararli hata kodu ve guvenli aciklama.",
        "headers": { "TraceId": { "$ref": "#/components/headers/TraceId" } },
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } }
        }
      }
    },
    "parameters": {
      "Page": {
        "name": "page", "in": "query", "description": "Bir tabanli sayfa numarasi.",
        "schema": { "type": "integer", "minimum": 1 }
      },
      "PageSize": {
        "name": "pageSize", "in": "query", "description": "Sunucunun sinirladigi sayfa boyutu.",
        "schema": { "type": "integer", "minimum": 1 }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key", "in": "header", "required": true,
        "description": "Ayni logical islem retry'larinda ayni kalan client anahtari.",
        "schema": { "type": "string", "minLength": 1 }
      }
    }
  }
}
